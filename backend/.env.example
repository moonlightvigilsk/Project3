# App Configuration
APP_NAME="Language Learning Tool"
ENVIRONMENT="development"
DEBUG=true

# Database (SQLite default)
DATABASE_URL="sqlite:///./language_tool.db"

# LLM Provider Configuration
# Options: "mock", "openai", "gemini", "ollama"
LLM_PROVIDER="mock"

# OpenAI / OpenAI-compatible configuration (Groq, DeepSeek, OpenRouter, etc.)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Google Gemini configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Ollama local configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# CORS configuration (comma separated origins or JSON array)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'
